#!/bin/sh

set -u

DOMAIN="gui/$(/usr/bin/id -u)"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/jumpproxy"
HOST_DIR="$CONFIG_ROOT/hosts"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/jumpproxy"

/bin/mkdir -p "$STATE_DIR"

log() {
    /bin/echo "$(/bin/date '+%Y-%m-%d %H:%M:%S') $*"
}

find_cloudflared() {
    if test -n "${CLOUDFLARED_BIN:-}" && test -x "$CLOUDFLARED_BIN"; then
        /usr/bin/printf '%s\n' "$CLOUDFLARED_BIN"
        return 0
    fi
    for candidate in \
        /opt/homebrew/bin/cloudflared \
        /usr/local/bin/cloudflared \
        "$HOME/.local/bin/cloudflared" \
        /usr/bin/cloudflared
    do
        if test -x "$candidate"; then
            /usr/bin/printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 127
}

find_identity() {
    for candidate in "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_ed25519"; do
        if test -r "$candidate"; then
            /usr/bin/printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

is_disabled() {
    /bin/launchctl print-disabled "$DOMAIN" 2>/dev/null |
        /usr/bin/awk -v target="\"$1\"" '
            $1 == target && ($3 == "disabled" || $3 == "true") { found = 1 }
            END { exit !found }
        '
}

ensure_loaded() {
    label="$1"
    plist="$HOME/Library/LaunchAgents/$label.plist"

    if is_disabled "$label"; then
        return 1
    fi
    if /bin/launchctl print "$DOMAIN/$label" >/dev/null 2>&1; then
        return 0
    fi
    if test ! -r "$plist"; then
        log "$label is not loaded and its plist is missing"
        return 1
    fi

    log "$label is not loaded; bootstrapping it"
    /bin/launchctl bootstrap "$DOMAIN" "$plist" >/dev/null 2>&1 || return 1
    /bin/launchctl kickstart "$DOMAIN/$label" >/dev/null 2>&1 || true
}

reset_failures() {
    /bin/echo 0 > "$STATE_DIR/$1.failures"
}

record_failure() {
    state_file="$STATE_DIR/$1.failures"
    failures=0
    if test -r "$state_file"; then
        failures=$(/bin/cat "$state_file" 2>/dev/null || /bin/echo 0)
    fi
    case "$failures" in
        ''|*[!0-9]*) failures=0 ;;
    esac
    failures=$((failures + 1))
    /bin/echo "$failures" > "$state_file"
    /bin/echo "$failures"
}

run_remote_check() {
    proxy_command="ProxyCommand=$CLOUDFLARED access ssh --hostname %h"
    remote_command="curl -fsS --connect-timeout 5 --max-time 10 -o /dev/null --proxy http://127.0.0.1:$REMOTE_PORT https://example.com/"

    if test -n "$IDENTITY"; then
        /usr/bin/ssh \
            -F /dev/null \
            -T \
            -o BatchMode=yes \
            -o ConnectionAttempts=1 \
            -o ConnectTimeout=15 \
            -o ServerAliveInterval=5 \
            -o ServerAliveCountMax=1 \
            -o StrictHostKeyChecking=accept-new \
            -o "IdentityFile=$IDENTITY" \
            -o "$proxy_command" \
            "$SSH_USER@$SSH_HOST" \
            "$remote_command" \
            >/dev/null 2>&1
    else
        /usr/bin/ssh \
            -F /dev/null \
            -T \
            -o BatchMode=yes \
            -o ConnectionAttempts=1 \
            -o ConnectTimeout=15 \
            -o ServerAliveInterval=5 \
            -o ServerAliveCountMax=1 \
            -o StrictHostKeyChecking=accept-new \
            -o "$proxy_command" \
            "$SSH_USER@$SSH_HOST" \
            "$remote_command" \
            >/dev/null 2>&1
    fi
}

check_proxy() {
    config="$1"
    SSH_HOST=""
    SSH_USER=""
    REMOTE_PORT=""
    LOCAL_PORT=""
    . "$config"
    label="com.jumpproxy.tunnel.$SSH_HOST"

    if is_disabled "$label"; then
        return 0
    fi
    if ! /usr/bin/nc -z -w 2 127.0.0.1 "$LOCAL_PORT" >/dev/null 2>&1; then
        log "$SSH_HOST: local proxy 127.0.0.1:$LOCAL_PORT unavailable; skipping"
        return 0
    fi
    ensure_loaded "$label" || return 0

    if run_remote_check; then
        state_file="$STATE_DIR/$label.failures"
        previous=0
        if test -r "$state_file"; then
            previous=$(/bin/cat "$state_file" 2>/dev/null || /bin/echo 0)
        fi
        reset_failures "$label"
        if test "$previous" -gt 0 2>/dev/null; then
            log "$SSH_HOST recovered"
        fi
        return 0
    fi

    failures=$(record_failure "$label")
    log "$SSH_HOST health check failed ($failures/2)"
    if test "$failures" -ge 2; then
        log "$SSH_HOST failed twice; restarting"
        /bin/launchctl kickstart -k "$DOMAIN/$label" >/dev/null 2>&1 || true
        reset_failures "$label"
    fi
}

CLOUDFLARED=$(find_cloudflared) || {
    log "cloudflared was not found"
    exit 127
}
IDENTITY=$(find_identity || true)

for config in "$HOST_DIR"/*.conf; do
    test -e "$config" || continue
    check_proxy "$config"
done

exit 0
