#!/bin/sh

set -u

if test "$#" -ne 5; then
    /bin/echo "jumpproxy-tunnel: expected HOST USER REMOTE_PORT LOCAL_PORT SSH_CONFIG" >&2
    exit 2
fi

SSH_HOST="$1"
SSH_USER="$2"
REMOTE_PORT="$3"
LOCAL_PORT="$4"
SSH_CONFIG="$5"

if test ! -r "$SSH_CONFIG"; then
    /bin/echo "SSH config is not readable: $SSH_CONFIG" >&2
    exit 2
fi

if test -n "$SSH_USER"; then
    TARGET="$SSH_USER@$SSH_HOST"
else
    TARGET="$SSH_HOST"
fi

# HostName, User, Port, IdentityFile, ProxyJump, and ProxyCommand are resolved
# exclusively by the selected SSH config. cloudflared is not a dependency of
# this service; it is only used when the SSH config itself requests it.
exec /usr/bin/ssh \
    -F "$SSH_CONFIG" \
    -N \
    -T \
    -o BatchMode=yes \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=15 \
    -o ServerAliveCountMax=2 \
    -o ConnectTimeout=20 \
    -o StrictHostKeyChecking=accept-new \
    -o ControlMaster=no \
    -o ControlPath=none \
    -o ControlPersist=no \
    -R "127.0.0.1:$REMOTE_PORT:127.0.0.1:$LOCAL_PORT" \
    "$TARGET"
